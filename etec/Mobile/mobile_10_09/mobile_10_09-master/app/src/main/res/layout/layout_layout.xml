<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LayoutActivity">

    <!-- Topo -->
    <View
        android:id="@+id/topo"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#C54242" />

    <!-- Sub-topo / Faixa de texto 1 -->
    <View
        android:id="@+id/texto1"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_below="@id/topo"
        android:background="#D78282" />

    <!-- Conteúdo Central -->
    <RelativeLayout
        android:id="@+id/container_centro"
        android:layout_width="match_parent"
        android:layout_height="667dp"
        android:layout_below="@id/texto1"
        android:background="@color/white"
        android:padding="16dp">

        <View
            android:id="@+id/perfil"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginEnd="16dp"
            android:background="#DB5757" />

        <EditText
            android:id="@+id/texto3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/perfil"
            android:hint="Price"
            android:inputType="numberDecimal"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/texto4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/texto3"
            android:layout_marginTop="10dp"
            android:layout_toEndOf="@id/perfil"
            android:hint="Price"
            android:inputType="numberDecimal"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/texto4"
            android:layout_marginTop="20dp"
            android:layout_toEndOf="@id/perfil"
            android:text="Download"
            android:textSize="18sp"
            app:cornerRadius="4dp" />

    </RelativeLayout>

    <!-- Rodapé 1 -->
    <View
        android:id="@+id/texto2"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_below="@id/container_centro"
        android:background="#D78282" />

    <!-- Rodapé Final -->
    <View
        android:id="@+id/fim"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@id/texto2"
        android:background="#C54242" />

</RelativeLayout>